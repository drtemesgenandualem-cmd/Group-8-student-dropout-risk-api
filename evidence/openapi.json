{
  "openapi": "3.1.0",
  "info": {
    "title": "Group 8 Student Dropout Prediction API",
    "description": "Predict academic outcomes from 28 first-semester features. Flag Dropout when P(Dropout) >= 0.38; otherwise choose Enrolled or Graduate. Early-warning aid for human review. All input fields are required.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health",
        "description": "A successful response means startup loaded and checked the model.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOutput"
                }
              }
            }
          }
        }
      }
    },
    "/predict": {
      "post": {
        "tags": [
          "Prediction"
        ],
        "summary": "Predict",
        "description": "Validate one student and apply the original Module 5 threshold rule.",
        "operationId": "predict_predict_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PredictionInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictionOutput"
                }
              }
            }
          },
          "500": {
            "description": "Internal prediction failure; no traceback is exposed."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ClassProbabilities": {
        "properties": {
          "Dropout": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Dropout"
          },
          "Enrolled": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Enrolled"
          },
          "Graduate": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Graduate"
          }
        },
        "type": "object",
        "required": [
          "Dropout",
          "Enrolled",
          "Graduate"
        ],
        "title": "ClassProbabilities"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthOutput": {
        "properties": {
          "status": {
            "type": "string",
            "const": "healthy",
